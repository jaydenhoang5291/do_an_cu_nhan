package scenarios

import (
	"context"
	"fmt"
	"sort"
	"stormsim/internal/common/logger"
	"stormsim/internal/core/gnbcontext"
	"stormsim/internal/core/uecontext"
	"stormsim/pkg/config"
	"stormsim/pkg/model"
	"sync"
	"time"
)

// NTNHandoverTimerTest implements the 5 test scenarios from NTN_Handover_Timer_TestPlan.md
type NTNHandoverTimerTest struct {
	config     *config.Config
	gnbMap     map[string]*gnbcontext.GnbContext
	ueCtx      *uecontext.UeContext
	logger     *logger.BufferedLogger
	exporter   *logger.CSVExporter
	wg         sync.WaitGroup
	ctx        context.Context
	cancel     context.CancelFunc
	testConfig NTNTestConfig
}

// NTNTestConfig holds NTN test configuration
type NTNTestConfig struct {
	ScenarioNumber int     // 1-5
	PDRLevels      []float64 // PDR values to test
	DelayLevels    []float64 // Delay values (ms)
	TrialsPerCombo int       // Number of trials per PDR/Delay combo
	OutputDir      string
	GnbPair        struct {
		Source string
		Target string
	}
}

// NewNTNHandoverTimerTest creates a new NTN test instance
func NewNTNHandoverTimerTest(
	cfg *config.Config,
	gnbMap map[string]*gnbcontext.GnbContext,
	ueCtx *uecontext.UeContext,
	testCfg NTNTestConfig,
) *NTNHandoverTimerTest {
	if testCfg.OutputDir == "" {
		testCfg.OutputDir = "./test-results"
	}

	ctx, cancel := context.WithCancel(context.Background())

	return &NTNHandoverTimerTest{
		config:     cfg,
		gnbMap:     gnbMap,
		ueCtx:      ueCtx,
		logger:     ueCtx.BufferedLogger,
		exporter:   logger.NewCSVExporter(testCfg.OutputDir),
		ctx:        ctx,
		cancel:     cancel,
		testConfig: testCfg,
	}
}

// RunScenario1_PDRDelayMatrix runs Scenario 1: PDR × Delay matrix
// Tests all timer combinations across PDR and delay conditions
func (t *NTNHandoverTimerTest) RunScenario1_PDRDelayMatrix() error {
	fmt.Println("============ NTN Scenario 1: PDR × Delay Matrix ============")

	if len(t.testConfig.PDRLevels) == 0 {
		t.testConfig.PDRLevels = []float64{0, 0.70, 0.80, 0.90, 0.95, 1.0}
	}
	if len(t.testConfig.DelayLevels) == 0 {
		t.testConfig.DelayLevels = []float64{1.2, 5.0, 10.0, 13.3}
	}
	if t.testConfig.TrialsPerCombo <= 0 {
		t.testConfig.TrialsPerCombo = 30
	}

	sourceGnb := t.gnbMap[t.testConfig.GnbPair.Source]
	targetGnb := t.gnbMap[t.testConfig.GnbPair.Target]
	if sourceGnb == nil || targetGnb == nil {
		return fmt.Errorf("source or target gNB not found in gnbMap")
	}

	var allStats []logger.PerTimerStats
	var trialSummaries []logger.TrialSummaryStats

	totalCombos := len(t.testConfig.PDRLevels) * len(t.testConfig.DelayLevels) * 2 // ×2 for Xn and NG
	currentCombo := 0

	// Test both Xn and NG for each PDR/Delay combination
	for _, pdr := range t.testConfig.PDRLevels {
		for _, delayMs := range t.testConfig.DelayLevels {
			for _, hoType := range []string{"Xn", "NG"} {
				currentCombo++
				fmt.Printf("\n[%d/%d] Testing PDR=%.2f%%, Delay=%.1fms, HO Type=%s\n",
					currentCombo, totalCombos, pdr*100, delayMs, hoType)

				// Run trials for this combination
				trialResults := t.runTrialsForCombination(
					sourceGnb, targetGnb, pdr, delayMs, hoType, t.testConfig.TrialsPerCombo,
				)

				// Aggregate statistics per timer
				stats := t.aggregatePerTimerStats("scenario1", pdr, delayMs, hoType, trialResults)
				allStats = append(allStats, stats...)

				// Add trial summaries
				for _, tr := range trialResults {
					trialSummaries = append(trialSummaries, logger.TrialSummaryStats{
						Scenario:      "scenario1",
						Pdr:           pdr,
						DelayMs:       delayMs,
						HoType:        hoType,
						TrialId:       tr.TrialId,
						OverallResult: tr.OverallResult,
						FailReason:    tr.FailReason,
						TotalHoMs:     tr.TotalHoMs,
						SourceGnb:     sourceGnb.GetId(),
						TargetGnb:     targetGnb.GetId(),
					})
				}
			}
		}
	}

	// Export results
	if err := t.exporter.ExportPerTimerStats(allStats, "results-per-timer.csv"); err != nil {
		return fmt.Errorf("failed to export per-timer stats: %w", err)
	}
	if err := t.exporter.ExportTrialSummaryStats(trialSummaries, "results-trial-summary.csv"); err != nil {
		return fmt.Errorf("failed to export trial summaries: %w", err)
	}

	fmt.Println("\n✓ Scenario 1 completed. Results exported.")
	return nil
}

// RunScenario2_T304Breakpoint runs Scenario 2: T304 breakpoint detection
// Finds the maximum delay that T304 can handle with <5% failure rate
func (t *NTNHandoverTimerTest) RunScenario2_T304Breakpoint() error {
	fmt.Println("============ NTN Scenario 2: T304 Breakpoint ============")

	sourceGnb := t.gnbMap[t.testConfig.GnbPair.Source]
	targetGnb := t.gnbMap[t.testConfig.GnbPair.Target]
	if sourceGnb == nil || targetGnb == nil {
		return fmt.Errorf("source or target gNB not found in gnbMap")
	}

	pdr := 0.0 // No packet loss for T304 test
	trialsPerStep := 50

	var allResults []logger.T304BreakpointStats

	// Delay sweep: 1ms to 20ms in 0.5ms steps
	for delayMs := 1.0; delayMs <= 20.0; delayMs += 0.5 {
		fmt.Printf("Testing T304 at delay=%.1fms with %d trials\n", delayMs, trialsPerStep)

		timeoutCount := 0
		var elapsedTimes []float64

		for trialId := 1; trialId <= trialsPerStep; trialId++ {
			t.logger.SetHandoverTrialId(trialId)

			startTime := time.Now()
			success := t.triggerHandoverAndWait(sourceGnb, targetGnb, pdr, delayMs, "Xn", 10*time.Second)
			duration := time.Since(startTime).Seconds() * 1000

			if !success {
				timeoutCount++
			}
			elapsedTimes = append(elapsedTimes, duration)
		}

		timeoutRate := float64(timeoutCount) / float64(trialsPerStep)
		allResults = append(allResults, logger.T304BreakpointStats{
			DelayMs:      delayMs,
			TotalTrials:  trialsPerStep,
			TimeoutCount: timeoutCount,
			TimeoutRate:  timeoutRate,
		})

		fmt.Printf("  Timeout rate: %.2f%% (%d/%d)\n", timeoutRate*100, timeoutCount, trialsPerStep)

		// Stop if we reach 5% failure threshold (breakpoint found)
		if timeoutRate >= 0.05 {
			fmt.Printf("✓ Breakpoint found at delay=%.1fms (timeout rate=%.2f%%)\n", delayMs, timeoutRate*100)
			break
		}
	}

	if err := t.exporter.ExportT304BreakpointStats(allResults, "results-t304-breakpoint.csv"); err != nil {
		return fmt.Errorf("failed to export T304 breakpoint stats: %w", err)
	}

	fmt.Println("\n✓ Scenario 2 completed.")
	return nil
}

// TrialResult represents the result of a single handover trial
type TrialResult struct {
	TrialId       int
	OverallResult string // "success" or "fail"
	FailReason    string
	TotalHoMs     float64
	TimerEvents   []logger.TimerEventEntry
	ElapsedTimes  map[string]float64 // timer_name -> elapsed_ms
}

// runTrialsForCombination runs multiple trials for a given PDR/Delay/HoType combination
func (t *NTNHandoverTimerTest) runTrialsForCombination(
	sourceGnb, targetGnb *gnbcontext.GnbContext,
	pdr, delayMs float64,
	hoType string,
	numTrials int,
) []TrialResult {
	var results []TrialResult

	for trialId := 1; trialId <= numTrials; trialId++ {
		t.logger.SetHandoverTrialId(trialId)

		// NOTE: Network conditions (PDR, delay) would normally be set via:
		// sourceGnb.SetUplinkLoss(pdr)
		// targetGnb.SetUplinkLoss(pdr)
		// sourceGnb.SetNetworkDelay(time.Duration(delayMs*1000) * time.Microsecond)
		// These methods need to be implemented in GnbContext if not already available

		// Wait for conditions to apply
		time.Sleep(100 * time.Millisecond)

		// Trigger handover
		startTime := time.Now()
		success := t.triggerHandoverAndWait(sourceGnb, targetGnb, pdr, delayMs, hoType, 15*time.Second)
		duration := time.Since(startTime).Seconds() * 1000

		// Get trial results
		failReason := ""
		if !success {
			failReason = "Timeout or HO failure"
		}
		overallResult := "success"
		if !success {
			overallResult = "fail"
		}

		// Log trial summary
		t.logger.LogHandoverTrialSummary(
			overallResult, failReason, duration, pdr, delayMs, hoType,
			sourceGnb.GetId(), targetGnb.GetId(),
		)

		results = append(results, TrialResult{
			TrialId:       trialId,
			OverallResult: overallResult,
			FailReason:    failReason,
			TotalHoMs:     duration,
		})

		// Small delay between trials
		time.Sleep(500 * time.Millisecond)
	}

	return results
}

// triggerHandoverAndWait triggers a handover and waits for completion
func (t *NTNHandoverTimerTest) triggerHandoverAndWait(
	sourceGnb, targetGnb *gnbcontext.GnbContext,
	pdr, delayMs float64,
	hoType string,
	timeout time.Duration,
) bool {
	ueId := int(t.ueCtx.GetId())
	prUeId := int64(ueId)

	// Check if UE is registered
	if t.ueCtx.GetMMState().CurrentState() != model.Registered {
		t.logger.Warn("UE not registered, skipping HO")
		return false
	}

	// Trigger handover directly via gNB context
	if hoType == "Xn" {
		gnbcontext.TriggerXnHandover(sourceGnb, targetGnb, prUeId, pdr, time.Duration(delayMs*1000)*time.Microsecond, 0)
	} else {
		gnbcontext.TriggerNgapHandover(sourceGnb, targetGnb, prUeId, pdr, time.Duration(delayMs*1000)*time.Microsecond, 0)
	}

	// Wait for handover to complete or timeout
	startTime := time.Now()
	ticker := time.NewTicker(200 * time.Millisecond)
	defer ticker.Stop()

	for {
		select {
		case <-t.ctx.Done():
			return false
		case <-time.After(timeout):
			t.logger.Warn("Handover timeout after %v", timeout)
			return false
		case <-ticker.C:
			// Check if HO is successful
			if sourceGnb.IsHandoverSuccess(int64(ueId)) {
				elapsed := time.Since(startTime)
				t.logger.Info("Handover succeeded in %v", elapsed)
				return true
			}
		}
	}
}

// aggregatePerTimerStats aggregates per-timer statistics from trial results
func (t *NTNHandoverTimerTest) aggregatePerTimerStats(
	scenario string,
	pdr, delayMs float64,
	hoType string,
	results []TrialResult,
) []logger.PerTimerStats {
	timerNames := []string{"T304", "T310", "T311", "T301", "TXnRELOCprep", "TXnRELOCoverall", "TNGRELOCprep", "TNGRELOCoverall"}
	var stats []logger.PerTimerStats

	// Get all timer events
	timerEvents := t.logger.GetTimerEvents()

	// Group by timer
	timerEventsByName := make(map[string][]logger.TimerEventEntry)
	for _, event := range timerEvents {
		if event.Pdr == pdr && event.DelayMs == delayMs && event.HoType == hoType {
			timerEventsByName[event.TimerName] = append(timerEventsByName[event.TimerName], event)
		}
	}

	// Calculate stats for each timer
	for _, timerName := range timerNames {
		events, ok := timerEventsByName[timerName]
		if !ok || len(events) == 0 {
			continue
		}

		successCount := 0
		timeoutCount := 0
		var elapsedTimes []float64

		for _, event := range events {
			if event.Result == "success" {
				successCount++
			} else if event.Result == "timeout" {
				timeoutCount++
			}
			if event.ElapsedMs > 0 {
				elapsedTimes = append(elapsedTimes, event.ElapsedMs)
			}
		}

		// Sort for percentile calculation
		sort.Float64s(elapsedTimes)

		p50 := logger.CalculatePercentile(elapsedTimes, 50)
		p95 := logger.CalculatePercentile(elapsedTimes, 95)
		p99 := logger.CalculatePercentile(elapsedTimes, 99)
		mean := 0.0
		if len(elapsedTimes) > 0 {
			sum := 0.0
			for _, v := range elapsedTimes {
				sum += v
			}
			mean = sum / float64(len(elapsedTimes))
		}

		successRate := 0.0
		totalEvents := len(events)
		if totalEvents > 0 {
			successRate = float64(successCount) / float64(totalEvents)
		}

		stats = append(stats, logger.PerTimerStats{
			Scenario:      scenario,
			Pdr:           pdr,
			DelayMs:       delayMs,
			HoType:        hoType,
			TimerName:     timerName,
			TotalTrials:   len(results),
			SuccessCount:  successCount,
			TimeoutCount:  timeoutCount,
			SuccessRate:   successRate,
			ElapsedP50Ms:  p50,
			ElapsedP95Ms:  p95,
			ElapsedP99Ms:  p99,
			ElapsedMeanMs: mean,
		})
	}

	return stats
}

// Cleanup stops the test context
func (t *NTNHandoverTimerTest) Cleanup() {
	t.cancel()
	t.wg.Wait()
}
